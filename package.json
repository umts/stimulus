{
  "name": "@umts/stimulus",
  "version": "0.0.0-dev",
  "type": "module",
  "exports": {
    "./*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "*",
    "@types/node": "*",
    "@typescript/typescript6": "*",
    "bootstrap": "*",
    "oxfmt": "*",
    "oxlint": "*",
    "sass": "*",
    "typescript": "*",
    "unplugin-dts": "*",
    "vite": "*"
  },
  "peerDependencies": {
    "@hotwired/stimulus": "3.*"
  },
  "allowScripts": {
    "fsevents": true
  }
}
