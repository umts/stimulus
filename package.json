{
  "name": "@umts/stimulus",
  "version": "0.0.0-dev",
  "description": "Stimulus controllers for UMTS rails apps.",
  "repository": {
    "url": "https://github.com/umts/stimulus"
  },
  "files": [
    "dist",
    "LICENSE.md",
    "README.md"
  ],
  "type": "module",
  "exports": {
    "./*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "docs": "vitepress dev docs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "*",
    "@types/node": "*",
    "@typescript/typescript6": "*",
    "@umts/brand": "github:umts/brand#main",
    "@vitest/browser-playwright": "*",
    "@vitest/coverage-istanbul": "*",
    "@vitest/ui": "*",
    "bootstrap": "*",
    "conventional-changelog-conventionalcommits": "< 10",
    "oxfmt": "*",
    "oxlint": "*",
    "playwright": "*",
    "sass": "*",
    "semantic-release": "*",
    "tom-select": "*",
    "typescript": "*",
    "unplugin-dts": "*",
    "vite": "*",
    "vitepress": "2.0.0-alpha.20",
    "vitest": "*"
  },
  "peerDependencies": {
    "@hotwired/stimulus": "3.*",
    "tom-select": "2.*"
  },
  "peerDependenciesMeta": {
    "tom-select": {
      "optional": true
    }
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "fsevents": true
  }
}
