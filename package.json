{
  "name": "@umts/stimulus",
  "version": "0.0.0-dev",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "*",
    "@types/node": "*",
    "@typescript/typescript6": "*",
    "oxfmt": "*",
    "oxlint": "*",
    "typescript": "*",
    "unplugin-dts": "*",
    "vite": "*"
  },
  "allowScripts": {
    "fsevents": true
  }
}
